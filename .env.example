# Discord Bot Token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Google Gemini API Key (for poll generation and chat)
API_KEY=your_gemini_api_key_here

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Comma-separated Discord Channel IDs where daily polls post
TARGET_CHANNEL_IDS=channel_id_1,channel_id_2

# (Optional) OpenRouter API Key for backup AI provider
OPENROUTER_API_KEY=your_openrouter_api_key_here
